---
// src/pages/404.astro
import Layout from '../layouts/Layout.astro';
---

<Layout title="Página no encontrada — GTA 6 Countdown" description="La página que buscas no existe.">
	<section class="mx-auto max-w-2xl px-4 pt-28 pb-20 text-center">
		<h1 class="gta-outline text-5xl font-black uppercase">404</h1>
		<p class="mt-4 text-white/70">Esta página no existe o se movió de lugar.</p>
		<a
			href="/"
			class="mt-8 inline-block rounded-full border border-white/20 px-8 py-3 text-sm font-black uppercase tracking-wide transition-colors hover:border-gta-pink hover:bg-white/10 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
		>
			Volver al inicio
		</a>
	</section>
</Layout>
