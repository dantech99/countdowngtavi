---
// src/pages/404.astro
//
// Bilingüe y sin diccionario: Vercel sirve este único 404.html para cualquier
// URL inexistente, incluidas las de /en/, así que la página no puede saber en
// qué idioma estaba el visitante. Mostrar los dos es más honesto que adivinar.
import Layout from '../layouts/Layout.astro';
---

<Layout
	title="Página no encontrada — Page not found"
	description="La página que buscas no existe. — The page you're looking for doesn't exist."
>
	<section class="mx-auto max-w-2xl px-4 pt-28 pb-20 text-center">
		<h1 class="gta-outline text-5xl font-black uppercase">404</h1>
		<p class="mt-4 text-white/70">Esta página no existe o se movió de lugar.</p>
		<p class="mt-1 text-white/50" lang="en">This page doesn't exist or has moved.</p>
		<div class="mt-8 flex flex-wrap justify-center gap-3">
			<a
				href="/"
				class="inline-block rounded-full border border-white/20 px-8 py-3 text-sm font-black uppercase tracking-wide transition-colors hover:border-gta-pink hover:bg-white/10 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
			>
				Volver al inicio
			</a>
			<a
				href="/en/"
				lang="en"
				class="inline-block rounded-full border border-white/20 px-8 py-3 text-sm font-black uppercase tracking-wide transition-colors hover:border-gta-pink hover:bg-white/10 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
			>
				Back home
			</a>
		</div>
	</section>
</Layout>
