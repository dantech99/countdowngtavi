---
// src/pages/[...locale]/index.astro
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/Hero.astro';
import Waitlist from '../../components/Waitlist.astro';
import NewsCard from '../../components/NewsCard.astro';
import Donations from '../../components/Donations.astro';
import TrailerCard from '../../components/TrailerCard.astro';
import { fetchAggregated, mergeNews } from '../../lib/news.js';
import { getLatestTrailers, watchUrl } from '../../lib/trailers.js';
import { articleSlug, byLang } from '../../lib/articulos.js';
import { getLangFromUrl, localizePath, useTranslations } from '../../i18n/utils';
import { DEFAULT_LANG, LANGS } from '../../i18n/ui';

// locale: undefined genera la ruta sin prefijo (/), que es cómo el idioma
// por defecto se queda en las URLs que el sitio ya tenía indexadas.
export function getStaticPaths() {
	return LANGS.map((lang) => ({
		params: { locale: lang === DEFAULT_LANG ? undefined : lang },
	}));
}

const lang = getLangFromUrl(Astro.url.pathname);
const t = useTranslations(lang);

const websiteSchema = {
	'@context': 'https://schema.org',
	'@type': 'WebSite',
	name: t('site.name'),
	url: new URL(Astro.url.pathname, Astro.site).href,
	description: t('home.description'),
	inLanguage: lang,
};

const trailers = getLatestTrailers(2);
const aggregated = await fetchAggregated();
const articulos = byLang(await getCollection('articulos'), lang);
const merged = mergeNews(articulos, aggregated);

const PREVIEW_COUNT = 9;

// The team's own articles are the site's differentiator, so always reserve a
// preview slot for the newest one instead of leaving it to open date
// competition with high-volume aggregated feeds.
const newestPropio = merged.find((entry) => entry.kind === 'propio');
const preview = newestPropio
	? [
			newestPropio,
			...merged.filter((entry) => entry !== newestPropio).slice(0, PREVIEW_COUNT - 1),
		].sort((a, b) => b.date.getTime() - a.date.getTime())
	: merged.slice(0, PREVIEW_COUNT);
---

<Layout title={t('home.title')} description={t('home.description')}>
	<script type="application/ld+json" is:inline set:html={JSON.stringify(websiteSchema)} />

	<Hero />

	<Waitlist />

	<section id="trailers" class="mx-auto max-w-5xl px-4 pt-20">
		<h2 class="text-2xl font-black uppercase mb-8">{t('trailers.heading')}</h2>
		<div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
			{trailers.map((trailer) => (
				<TrailerCard
					lang={lang}
					href={watchUrl(trailer.id)}
					label={trailer.label}
					title={trailer.title}
					poster={trailer.poster}
					uid={trailer.id}
				/>
			))}
		</div>
	</section>

	<section id="news-preview" class="mx-auto max-w-5xl px-4 py-20">
		<h2 class="text-2xl font-black uppercase mb-8">{t('news.latest')}</h2>
		<div class="columns-1 sm:columns-2 lg:columns-3 gap-4 [column-fill:balance]">
			{preview.map((entry) =>
				entry.kind === 'propio' ? (
					<NewsCard
						lang={lang}
						variant="propio"
						title={entry.entry.data.title}
						description={entry.entry.data.description}
						href={localizePath(lang, `/noticias/${articleSlug(entry.entry.id)}`)}
						coverSrc={entry.entry.data.cover}
						coverAlt={entry.entry.data.coverAlt}
						pubDate={entry.entry.data.pubDate}
					/>
				) : (
					<NewsCard
						lang={lang}
						variant="agregado"
						title={entry.item.title}
						href={entry.item.link}
						source={entry.item.source}
						pubDate={entry.item.pubDate}
						image={entry.item.image}
					/>
				)
			)}
		</div>
		<a href={localizePath(lang, '/noticias')} class="mt-4 mx-auto block w-fit rounded-full border border-white/20 px-6 py-2 text-sm uppercase tracking-wide hover:bg-white/10">
			{t('news.more')}
		</a>
	</section>

	<Donations />
</Layout>

<script>
	import { gsap } from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';

	gsap.registerPlugin(ScrollTrigger);

	gsap.from('#waitlist', {
		opacity: 0,
		y: 32,
		duration: 0.8,
		ease: 'power2.out',
		scrollTrigger: {
			trigger: '#waitlist',
			start: 'top 80%',
		},
	});

	gsap.from('#trailers', {
		opacity: 0,
		y: 32,
		duration: 0.8,
		ease: 'power2.out',
		scrollTrigger: {
			trigger: '#trailers',
			start: 'top 80%',
		},
	});

	gsap.from('#news-preview', {
		opacity: 0,
		y: 32,
		duration: 0.8,
		ease: 'power2.out',
		scrollTrigger: {
			trigger: '#news-preview',
			start: 'top 80%',
		},
	});
</script>
