---
interface Props {
  slotId: string;
}
const { slotId } = Astro.props;
---
<div class="my-8 min-h-[250px]">
  <ins
    class="adsbygoogle"
    style="display:block"
    data-ad-client="ca-pub-3667957730963677"
    data-ad-slot={slotId}
    data-ad-format="auto"
    data-full-width-responsive="true"
  ></ins>
</div>
<script is:inline>
  (adsbygoogle = window.adsbygoogle || []).push({});
</script>