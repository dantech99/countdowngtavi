---
// src/components/Donations.astro
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url.pathname);
const t = useTranslations(lang);

// Usuario de PayPal.me al que van las donaciones.
const paypalUser = 'countdowngtavi';
---

<section id="donaciones" class="mx-auto max-w-2xl px-4 py-20 text-center">
	<h2 class="text-2xl font-black uppercase">{t('donations.heading')}</h2>
	<p class="mt-4 text-white/70">{t('donations.body')}</p>
	<div class="mt-8 flex justify-center">
		<a
			href={`https://www.paypal.me/${paypalUser}`}
			target="_blank"
			rel="noopener noreferrer"
			class="inline-flex items-center gap-2 rounded-full border border-white/20 px-8 py-3 text-sm font-black uppercase tracking-wide transition-colors hover:border-gta-pink hover:bg-white/10 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
		>
			<svg
				class="h-5 w-5"
				viewBox="0 0 24 24"
				fill="currentColor"
				aria-hidden="true"
			>
				<path
					d="M7.076 21.337H2.47a.641.641 0 0 1-.633-.74L4.944.901C5.026.382 5.474 0 5.998 0h7.46c2.57 0 4.578.543 5.69 1.81.508.582.83 1.245.953 1.977.129.769.131 1.687.006 2.807l-.009.072v.621l.396.223c.336.18.603.386.808.62.34.394.559.895.65 1.489.094.612.063 1.34-.09 2.166-.177.95-.462 1.777-.848 2.454a4.8 4.8 0 0 1-1.34 1.472 5.44 5.44 0 0 1-1.807.816c-.68.176-1.455.265-2.305.265h-.548a1.65 1.65 0 0 0-1.628 1.393l-.041.225-.732 4.64-.033.171a.288.288 0 0 1-.283.24z"
				></path>
			</svg>
			{t('donations.cta')}
		</a>
	</div>
</section>
