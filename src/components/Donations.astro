---
// src/components/Donations.astro
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url.pathname);
const t = useTranslations(lang);
---

<section id="donaciones" class="mx-auto max-w-2xl px-4 py-20 text-center">
	<h2 class="text-2xl font-black uppercase">{t('donations.heading')}</h2>
	<p class="mt-4 text-white/70">{t('donations.body')}</p>
	<div class="mt-8 flex justify-center">
		<script type='text/javascript' src='https://storage.ko-fi.com/cdn/widget/Widget_2.js'>
		</script><script type='text/javascript'>kofiwidget2.init('Support me on Ko-fi', '#72a4f2', 'F6A2260NS6');kofiwidget2.draw();</script>
	</div>
</section>
