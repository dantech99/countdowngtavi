---
// src/components/Donations.astro
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url.pathname);
const t = useTranslations(lang);

// Botón de donaciones alojado en PayPal (Herramientas > Donaciones).
const hostedButtonId = 'W9TZC67SG35G4';

// PayPal sirve el arte del botón por locale; el texto va dentro de la imagen.
const buttonImage =
	lang === 'en'
		? 'https://www.paypalobjects.com/en_US/i/btn/btn_donateCC_LG.gif'
		: 'https://www.paypalobjects.com/es_ES/i/btn/btn_donateCC_LG.gif';
---

<section id="donaciones" class="mx-auto max-w-2xl px-4 py-20 text-center">
	<h2 class="text-2xl font-black uppercase">{t('donations.heading')}</h2>
	<p class="mt-4 text-white/70">{t('donations.body')}</p>
	<div class="mt-8 flex justify-center">
		<div
			id="donate-button"
			data-button-id={hostedButtonId}
			data-image-src={buttonImage}
			data-image-alt={t('donations.cta')}
		>
		</div>
	</div>
</section>

{/* is:inline en ambos: el SDK expone el global `PayPal` y Astro, sin la
directiva, convertiría el script de abajo en un módulo diferido que correría
antes de que ese global exista. */}
<script
	is:inline
	src="https://www.paypalobjects.com/donate/sdk/donate-sdk.js"
	charset="UTF-8"></script>
<script is:inline>
	(function () {
		var el = document.getElementById('donate-button');
		if (!el || typeof PayPal === 'undefined') return;

		PayPal.Donation.Button({
			env: 'production',
			hosted_button_id: el.dataset.buttonId,
			image: {
				src: el.dataset.imageSrc,
				alt: el.dataset.imageAlt,
				title: el.dataset.imageAlt,
			},
		}).render('#donate-button');
	})();
</script>
