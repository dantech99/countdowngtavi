---
// src/components/Gallery.astro
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { toSlides } from '../lib/gallery.js';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const SOURCE_URL = 'https://www.rockstargames.com/VI/launch-gallery';

const lang = getLangFromUrl(Astro.url.pathname);
const t = useTranslations(lang);

const files = import.meta.glob<{ default: ImageMetadata }>('../assets/launch-gallery/*.jpg', {
	eager: true,
});
const slides = toSlides(Object.keys(files));
const total = slides.length;
---

<section id="gallery" class="mx-auto max-w-5xl px-4 pt-20" data-gallery>
	<div class="mb-8 flex items-center justify-between gap-4">
		<h2 class="text-2xl font-black uppercase">{t('gallery.heading')}</h2>

		<div class="flex items-center gap-3">
			<p class="text-sm tabular-nums text-white/70">
				<span data-gallery-current>1</span> / {total}
			</p>
			<button
				type="button"
				data-gallery-prev
				aria-label={t('gallery.prev')}
				disabled
				class="grid h-10 w-10 place-items-center rounded-full border border-white/20 transition-colors hover:bg-white/10 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white disabled:pointer-events-none disabled:opacity-30"
			>
				<svg viewBox="0 0 24 24" class="h-5 w-5 fill-none stroke-current stroke-2" aria-hidden="true">
					<path d="M15 5l-7 7 7 7" stroke-linecap="round" stroke-linejoin="round"></path>
				</svg>
			</button>
			<button
				type="button"
				data-gallery-next
				aria-label={t('gallery.next')}
				class="grid h-10 w-10 place-items-center rounded-full border border-white/20 transition-colors hover:bg-white/10 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white disabled:pointer-events-none disabled:opacity-30"
			>
				<svg viewBox="0 0 24 24" class="h-5 w-5 fill-none stroke-current stroke-2" aria-hidden="true">
					<path d="M9 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"></path>
				</svg>
			</button>
		</div>
	</div>

	<!-- Native horizontal scroll with snap points: touch, trackpad and keyboard
	     work without JS; the script only wires the buttons and the counter. -->
	<ul
		data-gallery-track
		role="region"
		aria-label={t('gallery.region')}
		tabindex="0"
		class="flex snap-x snap-mandatory gap-4 overflow-x-auto rounded-2xl [scrollbar-width:none] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white [&::-webkit-scrollbar]:hidden"
	>
		{slides.map((slide, index) => (
			<li
				data-gallery-slide
				class="aspect-video w-[88%] shrink-0 snap-center overflow-hidden rounded-2xl ring-1 ring-inset ring-white/15 sm:w-[75%]"
			>
				<Image
					src={files[slide.path].default}
					alt={t('gallery.alt', {
						subject: t(`gallery.subject.${slide.subject}`),
						n: index + 1,
						total,
					})}
					widths={[640, 960, 1280, 1920]}
					sizes="(min-width: 1024px) 744px, (min-width: 640px) 75vw, 88vw"
					loading="lazy"
					class="h-full w-full object-cover"
				/>
			</li>
		))}
	</ul>

	<p class="mt-4 text-xs text-white/60">
		<a href={SOURCE_URL} target="_blank" rel="noopener noreferrer" class="underline hover:text-white">
			{t('gallery.credit')}
		</a>
	</p>
</section>

<script>
	for (const gallery of document.querySelectorAll<HTMLElement>('[data-gallery]')) {
		const track = gallery.querySelector<HTMLElement>('[data-gallery-track]');
		const prev = gallery.querySelector<HTMLButtonElement>('[data-gallery-prev]');
		const next = gallery.querySelector<HTMLButtonElement>('[data-gallery-next]');
		const current = gallery.querySelector<HTMLElement>('[data-gallery-current]');
		const slides = [...gallery.querySelectorAll<HTMLElement>('[data-gallery-slide]')];

		if (!track || !prev || !next || !current || slides.length === 0) continue;

		let active = 0;

		const show = (index: number) => {
			active = Math.max(0, Math.min(slides.length - 1, index));
			current.textContent = String(active + 1);
			prev.disabled = active === 0;
			next.disabled = active === slides.length - 1;
		};

		const goTo = (index: number) => {
			const target = slides[Math.max(0, Math.min(slides.length - 1, index))];
			const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
			// Scroll the track itself, not scrollIntoView, which would also move
			// the page vertically when the section is only partly on screen.
			track.scrollTo({
				left: target.offsetLeft - (track.clientWidth - target.clientWidth) / 2,
				behavior: reduceMotion ? 'auto' : 'smooth',
			});
		};

		prev.addEventListener('click', () => goTo(active - 1));
		next.addEventListener('click', () => goTo(active + 1));

		// The slide closest to the centre of the track is the active one. An
		// observer keeps this off the scroll event's hot path.
		const observer = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (entry.isIntersecting) show(slides.indexOf(entry.target as HTMLElement));
				}
			},
			{ root: track, threshold: 0.6 },
		);
		for (const slide of slides) observer.observe(slide);
	}
</script>
