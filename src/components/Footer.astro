---
// src/components/Footer.astro
import { getLangFromUrl, localizePath, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url.pathname);
const t = useTranslations(lang);
const year = new Date().getFullYear();
---

<footer class="border-t border-white/10 px-4 py-8 text-center text-sm text-white/50">
	<p>© {year} {t('site.name')}. {t('footer.disclaimer')}</p>
	<p class="mt-2">
		<a href={localizePath(lang, '/')} class="underline hover:text-white">{t('nav.home')}</a>
		<span class="mx-2">·</span>
		<a href={localizePath(lang, '/noticias')} class="underline hover:text-white">{t('nav.news')}</a>
		<span class="mx-2">·</span>
		<a href={`${localizePath(lang, '/')}#waitlist`} class="underline hover:text-white">{t('nav.waitlist')}</a>
		<span class="mx-2">·</span>
		<a href="#donaciones" class="underline hover:text-white">{t('nav.donations')}</a>
		<span class="mx-2">·</span>
		<a href={localizePath(lang, '/privacidad')} class="underline hover:text-white">{t('nav.privacy')}</a>
	</p>
</footer>
