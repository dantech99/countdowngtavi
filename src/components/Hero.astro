---
// src/components/Hero.astro
import { Image } from 'astro:assets';
import heroBg from '../assets/background-gta6.png';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url.pathname);
const t = useTranslations(lang);
---

<section id="hero" class="relative h-screen w-full overflow-hidden flex items-center justify-center text-center">
	<Image
		id="hero-bg"
		src={heroBg}
		alt={t('hero.bgAlt')}
		class="absolute -top-[10%] left-0 h-[115%] w-full object-cover will-change-transform sm:-top-[30%] sm:h-[140%]"
		loading="eager"
		fetchpriority="high"
		widths={[640, 1280, 1920, 3840]}
		sizes="100vw"
	/>
	<div id="hero-overlay" class="absolute inset-0 bg-black opacity-40"></div>

	<div id="hero-content" class="relative z-10 flex flex-col items-center gap-6 px-4 will-change-transform">
		<h1 class="gta-outline text-4xl sm:text-6xl md:text-7xl font-black uppercase tracking-wide">
			{t('hero.title')}
		</h1>

		<div class="flex gap-4 sm:gap-8" data-countdown data-target="2026-11-19T00:00:00">
			<div class="flex flex-col items-center">
				<span class="gta-outline text-4xl sm:text-6xl font-black tabular-nums" data-unit="days">--</span>
				<span class="gta-outline-soft text-xs sm:text-sm uppercase tracking-widest text-white/80">{t('hero.days')}</span>
			</div>
			<div class="flex flex-col items-center">
				<span class="gta-outline text-4xl sm:text-6xl font-black tabular-nums" data-unit="hours">--</span>
				<span class="gta-outline-soft text-xs sm:text-sm uppercase tracking-widest text-white/80">{t('hero.hours')}</span>
			</div>
			<div class="flex flex-col items-center">
				<span class="gta-outline text-4xl sm:text-6xl font-black tabular-nums" data-unit="minutes">--</span>
				<span class="gta-outline-soft text-xs sm:text-sm uppercase tracking-widest text-white/80">{t('hero.minutes')}</span>
			</div>
			<div class="flex flex-col items-center">
				<span class="gta-outline text-4xl sm:text-6xl font-black tabular-nums" data-unit="seconds">--</span>
				<span class="gta-outline-soft text-xs sm:text-sm uppercase tracking-widest text-white/80">{t('hero.seconds')}</span>
			</div>
		</div>

		<p class="max-w-md text-xs sm:text-sm text-white/80">
			{t('hero.disclaimer')}
		</p>
	</div>

	<div id="scroll-indicator" class="absolute bottom-8 z-10 text-white/80">
		<svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
			<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
		</svg>
	</div>
</section>

<script>
	import { gsap } from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';
	import { getTimeRemaining } from '../lib/countdown.js';

	gsap.registerPlugin(ScrollTrigger);

	const hero = document.getElementById('hero')!;
	const countdownEl = hero.querySelector('[data-countdown]') as HTMLElement;
	const targetDate = countdownEl.dataset.target as string;
	const unitEls: Record<'days' | 'hours' | 'minutes' | 'seconds', HTMLElement> = {
		days: hero.querySelector('[data-unit="days"]') as HTMLElement,
		hours: hero.querySelector('[data-unit="hours"]') as HTMLElement,
		minutes: hero.querySelector('[data-unit="minutes"]') as HTMLElement,
		seconds: hero.querySelector('[data-unit="seconds"]') as HTMLElement,
	};

	function pad(value: number) {
		return String(value).padStart(2, '0');
	}

	function render() {
		const remaining = getTimeRemaining(targetDate);
		for (const [unit, el] of Object.entries(unitEls) as [keyof typeof unitEls, HTMLElement][]) {
			const nextValue = pad(remaining[unit]);
			if (el.textContent !== nextValue) {
				el.textContent = nextValue;
				gsap.fromTo(el, { scale: 1.3, opacity: 0.4 }, { scale: 1, opacity: 1, duration: 0.35, ease: 'power2.out' });
			}
		}
	}

	render();
	setInterval(render, 1000);

	// Parallax: the artwork drifts down as the page scrolls up, so it travels
	// less than the viewport and reads as distant, while the copy travels
	// faster than the page and fades out. Both are motion effects, so
	// matchMedia keeps them off for anyone who asked for reduced motion —
	// and reverts them cleanly if that preference changes mid-session.
	const mm = gsap.matchMedia();

	// The travel distance has to stay inside the slack the layer was given:
	// the image starts at -10%/-30% of the hero and is 115%/140% tall, so
	// drifting further than that would expose the top edge. On phones the
	// layer is shorter, because a 140%-tall cover crop throws away most of
	// the artwork's width.
	function parallax(distance: string) {
		gsap.to('#hero-bg', {
			y: distance,
			ease: 'none',
			scrollTrigger: {
				trigger: hero,
				start: 'top top',
				end: 'bottom top',
				scrub: true,
			},
		});

		gsap.to('#hero-content', {
			y: -90,
			opacity: 0,
			ease: 'none',
			scrollTrigger: {
				trigger: hero,
				start: 'top top',
				end: '75% top',
				scrub: true,
			},
		});
	}

	mm.add('(prefers-reduced-motion: no-preference) and (max-width: 639px)', () => parallax('8vh'));
	mm.add('(prefers-reduced-motion: no-preference) and (min-width: 640px)', () => parallax('25vh'));

	gsap.to('#hero-overlay', {
		opacity: 0.85,
		ease: 'none',
		scrollTrigger: {
			trigger: hero,
			start: 'top top',
			end: 'bottom top',
			scrub: true,
		},
	});

	gsap.to('#scroll-indicator', {
		y: 10,
		repeat: -1,
		yoyo: true,
		duration: 0.8,
		ease: 'sine.inOut',
	});

	gsap.to('#scroll-indicator', {
		opacity: 0,
		ease: 'none',
		scrollTrigger: {
			trigger: hero,
			start: 'top top',
			end: '150px top',
			scrub: true,
		},
	});
</script>
