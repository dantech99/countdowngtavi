---
// src/components/Hero.astro
import type { ImageMetadata } from 'astro';
import { Image, getImage } from 'astro:assets';
import { toSlides } from '../lib/gallery.js';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url.pathname);
const t = useTranslations(lang);

// Same widths as Gallery.astro, so both components share the generated files
// instead of producing a second set of variants for the same 39 screenshots.
const WIDTHS = [640, 960, 1280, 1920];
const SIZES = '100vw';

const files = import.meta.glob<{ default: ImageMetadata }>('../assets/launch-gallery/*.jpg', {
	eager: true,
});
const slides = toSlides(Object.keys(files));

// Only the first slide is in the HTML as an image. The rest travel as URLs
// and are fetched one at a time, right before they are shown: 39 stacked
// <img> elements would all download on load, visible or not.
const sources = await Promise.all(
	slides.map(async (slide) => {
		const image = await getImage({ src: files[slide.path].default, widths: WIDTHS, sizes: SIZES });
		return { src: image.src, srcset: image.srcSet.attribute };
	}),
);
---

<section id="hero" class="relative h-screen w-full overflow-hidden flex items-center justify-center text-center">
	<div
		id="hero-bg"
		role="img"
		aria-label={t('hero.bgAlt')}
		data-hero-slides={JSON.stringify(sources)}
		class="absolute -top-[10%] left-0 isolate h-[115%] w-full will-change-transform sm:-top-[30%] sm:h-[140%]"
	>
		<Image
			src={files[slides[0].path].default}
			alt=""
			class="absolute inset-0 h-full w-full object-cover"
			loading="eager"
			fetchpriority="high"
			widths={WIDTHS}
			sizes={SIZES}
		/>
	</div>
	<div id="hero-overlay" class="absolute inset-0 bg-black opacity-40"></div>

	<div id="hero-content" class="relative z-10 flex flex-col items-center gap-6 px-4 will-change-transform">
		<h1 class="gta-outline text-4xl sm:text-6xl md:text-7xl font-black uppercase tracking-wide">
			{t('hero.title')}
		</h1>

		<div class="flex gap-4 sm:gap-8" data-countdown data-target="2026-11-19T00:00:00">
			<div class="flex flex-col items-center">
				<span class="gta-outline text-4xl sm:text-6xl font-black tabular-nums" data-unit="days">--</span>
				<span class="gta-outline-soft text-xs sm:text-sm uppercase tracking-widest text-white/80">{t('hero.days')}</span>
			</div>
			<div class="flex flex-col items-center">
				<span class="gta-outline text-4xl sm:text-6xl font-black tabular-nums" data-unit="hours">--</span>
				<span class="gta-outline-soft text-xs sm:text-sm uppercase tracking-widest text-white/80">{t('hero.hours')}</span>
			</div>
			<div class="flex flex-col items-center">
				<span class="gta-outline text-4xl sm:text-6xl font-black tabular-nums" data-unit="minutes">--</span>
				<span class="gta-outline-soft text-xs sm:text-sm uppercase tracking-widest text-white/80">{t('hero.minutes')}</span>
			</div>
			<div class="flex flex-col items-center">
				<span class="gta-outline text-4xl sm:text-6xl font-black tabular-nums" data-unit="seconds">--</span>
				<span class="gta-outline-soft text-xs sm:text-sm uppercase tracking-widest text-white/80">{t('hero.seconds')}</span>
			</div>
		</div>

		<p class="max-w-md text-xs sm:text-sm text-white/80">
			{t('hero.disclaimer')}
		</p>
	</div>

	<div id="scroll-indicator" class="absolute bottom-8 z-10 text-white/80">
		<svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
			<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
		</svg>
	</div>
</section>

<script>
	import { gsap } from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';
	import { getTimeRemaining } from '../lib/countdown.js';

	gsap.registerPlugin(ScrollTrigger);

	const hero = document.getElementById('hero')!;
	const countdownEl = hero.querySelector('[data-countdown]') as HTMLElement;
	const targetDate = countdownEl.dataset.target as string;
	const unitEls: Record<'days' | 'hours' | 'minutes' | 'seconds', HTMLElement> = {
		days: hero.querySelector('[data-unit="days"]') as HTMLElement,
		hours: hero.querySelector('[data-unit="hours"]') as HTMLElement,
		minutes: hero.querySelector('[data-unit="minutes"]') as HTMLElement,
		seconds: hero.querySelector('[data-unit="seconds"]') as HTMLElement,
	};

	function pad(value: number) {
		return String(value).padStart(2, '0');
	}

	function render() {
		const remaining = getTimeRemaining(targetDate);
		for (const [unit, el] of Object.entries(unitEls) as [keyof typeof unitEls, HTMLElement][]) {
			const nextValue = pad(remaining[unit]);
			if (el.textContent !== nextValue) {
				el.textContent = nextValue;
				gsap.fromTo(el, { scale: 1.3, opacity: 0.4 }, { scale: 1, opacity: 1, duration: 0.35, ease: 'power2.out' });
			}
		}
	}

	render();
	setInterval(render, 1000);

	// Parallax: the artwork drifts down as the page scrolls up, so it travels
	// less than the viewport and reads as distant, while the copy travels
	// faster than the page and fades out. Both are motion effects, so
	// matchMedia keeps them off for anyone who asked for reduced motion —
	// and reverts them cleanly if that preference changes mid-session.
	const mm = gsap.matchMedia();

	// The travel distance has to stay inside the slack the layer was given:
	// the image starts at -10%/-30% of the hero and is 115%/140% tall, so
	// drifting further than that would expose the top edge. On phones the
	// layer is shorter, because a 140%-tall cover crop throws away most of
	// the artwork's width.
	function parallax(distance: string) {
		gsap.to('#hero-bg', {
			y: distance,
			ease: 'none',
			scrollTrigger: {
				trigger: hero,
				start: 'top top',
				end: 'bottom top',
				scrub: true,
			},
		});

		gsap.to('#hero-content', {
			y: -90,
			opacity: 0,
			ease: 'none',
			scrollTrigger: {
				trigger: hero,
				start: 'top top',
				end: '75% top',
				scrub: true,
			},
		});
	}

	mm.add('(prefers-reduced-motion: no-preference) and (max-width: 639px)', () => parallax('8vh'));
	mm.add('(prefers-reduced-motion: no-preference) and (min-width: 640px)', () => parallax('25vh'));

	// Background slideshow: two stacked layers. The hidden one loads the next
	// screenshot, fades in on top of the visible one, and then they swap roles.
	// The outgoing layer stays opaque during the fade, so the artwork never
	// dips to black between two slides.
	const SLIDE_INTERVAL_MS = 7000;
	const SLIDE_FADE_S = 1.5;

	const bg = document.getElementById('hero-bg')!;
	const slideSources: { src: string; srcset: string }[] = JSON.parse(bg.dataset.heroSlides ?? '[]');
	let front = bg.querySelector('img')!;
	let back = front.cloneNode(false) as HTMLImageElement;
	back.removeAttribute('fetchpriority');
	back.loading = 'eager';
	back.style.opacity = '0';
	bg.append(back);

	let slideIndex = 0;
	let fading = false;

	async function nextSlide() {
		// Nothing to see: the tab is in the background or the hero has been
		// scrolled past. Skipping the tick also skips the download.
		if (fading || document.hidden || hero.getBoundingClientRect().bottom <= 0) return;

		const nextIndex = (slideIndex + 1) % slideSources.length;
		const source = slideSources[nextIndex];
		fading = true;
		try {
			back.srcset = source.srcset;
			back.src = source.src;
			await back.decode();
		} catch {
			// The image failed to load; keep the current one and retry on the
			// next tick.
			fading = false;
			return;
		}

		const incoming = back;
		const outgoing = front;
		gsap.set(incoming, { zIndex: 1 });
		gsap.to(incoming, {
			opacity: 1,
			duration: SLIDE_FADE_S,
			ease: 'power1.inOut',
			onComplete: () => {
				gsap.set(outgoing, { opacity: 0 });
				gsap.set(incoming, { zIndex: 0 });
				front = incoming;
				back = outgoing;
				slideIndex = nextIndex;
				fading = false;
			},
		});
	}

	// A background that keeps changing is motion too, so reduced motion keeps
	// the first screenshot as a static image.
	mm.add('(prefers-reduced-motion: no-preference)', () => {
		if (slideSources.length < 2) return;
		const timer = setInterval(nextSlide, SLIDE_INTERVAL_MS);
		return () => clearInterval(timer);
	});

	gsap.to('#hero-overlay', {
		opacity: 0.85,
		ease: 'none',
		scrollTrigger: {
			trigger: hero,
			start: 'top top',
			end: 'bottom top',
			scrub: true,
		},
	});

	gsap.to('#scroll-indicator', {
		y: 10,
		repeat: -1,
		yoyo: true,
		duration: 0.8,
		ease: 'sine.inOut',
	});

	gsap.to('#scroll-indicator', {
		opacity: 0,
		ease: 'none',
		scrollTrigger: {
			trigger: hero,
			start: 'top top',
			end: '150px top',
			scrub: true,
		},
	});
</script>
